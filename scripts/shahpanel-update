#!/usr/bin/env bash
#
# shahpanel-update — root-side launcher for the admin panel's "Update" button.
#
# Installed at: /usr/local/sbin/shahpanel-update  (root:root 0750)
# Called by:    App\Http\Controllers\Admin\PanelUpdateController via
#               `sudo -n /usr/local/sbin/shahpanel-update <token> <stamp>`
#               (sudoers: /etc/sudoers.d/shahpanel-update, this exact path only)
#
# The only input taken from the caller is a 32-hex token (names the progress
# files) and a YYYYmmdd-HHMMSS stamp (names the database backup the admin was
# shown). It runs the root-owned copy of update.sh at
# /usr/local/lib/shahpanel/update.sh -- never a file the web user can edit --
# in its own systemd unit, so the update survives the php-fpm restart it
# performs, and returns at once.
#
set -euo pipefail

APP_DIR="__APP_DIR__"
UPDATER="/usr/local/lib/shahpanel/update.sh"
OUT="$APP_DIR/public/update-progress"

TOKEN="${1:-}"
STAMP="${2:-}"

[[ "$TOKEN" =~ ^[a-f0-9]{32}$ ]] || { echo "invalid token" >&2; exit 2; }
[[ "$STAMP" =~ ^[0-9]{8}-[0-9]{6}$ ]] || { echo "invalid stamp" >&2; exit 2; }
[[ -f "$UPDATER" ]] || { echo "updater not installed: $UPDATER" >&2; exit 3; }

install -d -o root -g root -m 0755 "$OUT"
# Progress files are only useful while someone is watching.
find "$OUT" -maxdepth 1 -type f -mmin +1440 -delete 2>/dev/null || true

# .txt, not .log: the OWASP Core Rule Set (ops/modsecurity) refuses requests
# for .log files, which left the page's console empty.
LOG_FILE="$OUT/$TOKEN.txt"
STATUS_FILE="$OUT/$TOKEN.json"
: > "$LOG_FILE"
chmod 0644 "$LOG_FILE"
printf '{"status":"queued","stage":"queued"}' > "$STATUS_FILE"
chmod 0644 "$STATUS_FILE"

# One update at a time; a second click is reported, not started.
RUNNER="exec 9>/run/shahpanel-update.lock
if ! flock -n 9; then
  printf '{\"status\":\"failed\",\"stage\":\"queued\",\"error\":\"another update is already running\"}' > '$STATUS_FILE'
  exit 1
fi
exec env HOME=/root PANEL_UPDATE_WEB=1 PANEL_UPDATE_STAMP='$STAMP' PANEL_UPDATE_STATUS='$STATUS_FILE' APP_DIR='$APP_DIR' bash '$UPDATER' >> '$LOG_FILE' 2>&1 < /dev/null"

if command -v systemd-run >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
  # A transient unit of its own: outside php-fpm's cgroup, so restarting PHP
  # (the last step of every update) does not kill the update itself.
  systemd-run --quiet --collect --unit="shahpanel-update-${TOKEN:0:12}" \
    --description="ShahPanel web update" /bin/bash -c "$RUNNER"
else
  setsid nohup /bin/bash -c "$RUNNER" >/dev/null 2>&1 < /dev/null &
fi

echo "started"
