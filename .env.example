APP_NAME="سامانه امور مشتریان"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Days of log files to keep. Raise only while debugging — logs grow fast.
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shahpanel
# Never run the panel as the MySQL root user. install.sh creates a dedicated
# account limited to this one database.
DB_USERNAME=shahpanel
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set to true once the panel is served over HTTPS (install.sh does this for you).
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=shahpanel_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# سامانه امور مشتریان
VPN_CURRENCY=IRT
VPN_CURRENCY_LABEL=تومان
VPN_ACCENT_COLOR=#2563eb
VPN_SYNC_INTERVAL=5
VPN_API_TIMEOUT=15
VPN_API_RETRY=3

# Login paths for each portal. install.sh generates a random admin path so that
# /admin — the first thing every scanner tries — is not the way in.
# Changeable later from the panel: Settings > Security > Portal paths.
VPN_ADMIN_PATH=admin
VPN_AGENT_PATH=agent
VPN_SELLER_PATH=seller

MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_SSL_PORT=8729

SANAEI_DEFAULT_PORT=2053
SANAEI_API_PREFIX=/panel/api
# Verify the panel TLS certificate (admin credentials are sent on every login).
# Leave true; turn it off per server from the server edit form for self-signed panels.
SANAEI_VERIFY_SSL=true
SANAEI_CONNECT_TIMEOUT=5
# Ceiling for the URL/prefix fallback fan-out on a single panel write.
SANAEI_MAX_POST_ATTEMPTS=12
SANAEI_OPERATION_DEADLINE=45

CISCO_ANYCONNECT_VERIFY_SSL=true
CISCO_ANYCONNECT_WRITE_MEMORY_TIMEOUT=180

# ocserv (OpenConnect). The port below is the JSON management API that runs
# alongside ocserv — customers still connect on 443.
#OCSERV_DEFAULT_PORT=9443
#OCSERV_TIMEOUT=30
#OCSERV_VERIFY_SSL=true
#OCSERV_USERNAME_PREFIX=VPL
#OCSERV_DEFAULT_MAX_SESSIONS=1

# Installer recovery (optional, set only via SSH for lock bypass)
INSTALL_RECOVERY_TOKEN=

# Standalone recovery page at /maintain.php. Empty = the page 404s for everyone.
# Set a token only while debugging a panel that will not boot, then clear it:
#   echo "MAINTAIN_TOKEN=$(php -r 'echo bin2hex(random_bytes(16));')" >> .env
MAINTAIN_TOKEN=

# Security
SECURITY_FIREWALL=true
SECURITY_FIREWALL_LOG=true
# Comma-separated admin panel IP whitelist (empty = allow all)
SECURITY_ADMIN_IP_WHITELIST=
